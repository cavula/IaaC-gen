# Copy to .env and fill in. Never commit .env.
# The API key is better stored in the OS keychain; this is a fallback.
APP_LLM_PROVIDER=
APP_LLM_MODEL=
APP_LLM_API_KEY=
# Only for providers without a built in endpoint (provider openai_compatible).
APP_LLM_API_BASE=
# Optional. Where projects and the audit log are stored. Default: ~/app-workspace
APP_WORKSPACE_DIR=
